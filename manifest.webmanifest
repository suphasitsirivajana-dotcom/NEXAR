{
  "name": "NEXAR — BIM on site",
  "short_name": "NEXAR",
  "description": "BIM site markup in AR: IFC / DXF / GLB, GPS + QR positioning, BCF export for NEXBIM, Revit and openBIM.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0A0A0C",
  "theme_color": "#0A0A0C",
  "categories": ["productivity", "utilities", "business"],
  "icons": [
    { "src": "brand/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "brand/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "brand/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "brand/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-step": [".ifc"], "application/dxf": [".dxf"], "model/gltf-binary": [".glb"] } }
  ]
}
